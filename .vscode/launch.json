    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch compute_state_measurement",
            "program": "${workspaceFolder}/target/debug/compute_state_measurement",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stdio": ["${workspaceFolder}/test_input.txt", null, null]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch test-model",
            "program": "${workspaceFolder}/target/debug/test-model",
            "args": [],
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch compute_trajectory",
            "program": "${workspaceFolder}/target/debug/compute_trajectory",
            "args": ["--param-json", "analysis/data/robot_params.json"],
            "cwd": "${workspaceFolder}",
            "stdio": ["${workspaceFolder}/test_input_trajectory.txt", null, null]
        },
        {
            "name": "Run telem_bag2np.py",
            "type": "debugpy",
            "request": "launch",
            "program": "analysis/scripts/telem_bag2np.py",
            "console": "integratedTerminal",
            "args": "--bag data/tuning_iter_264 --robot 2 --output data/telemetry_264.npz"
        },
        {
            "name": "Run kalman_visualize.py",
            "type": "debugpy",
            "request": "launch",
            "program": "analysis/scripts/kalman_visualize.py",
            "console": "integratedTerminal",
            "args": "--telemetry data/tuning_iter_94.npz --param-json analysis/data/robot_params.json"
        },
        {
            "name": "Run telem_visualize.py",
            "type": "debugpy",
            "request": "launch",
            "program": "analysis/scripts/telem_visualize.py",
            "console": "integratedTerminal",
            "args": "--telemetry data/tuning_iter_21.npz"
        },
        {
            "name": "Run wheel_visualize.py",
            "type": "debugpy",
            "request": "launch",
            "program": "analysis/scripts/wheel_visualize.py",
            "console": "integratedTerminal",
            "args": "--telemetry data/tuning_iter_264.npz"
        }
    ]
}